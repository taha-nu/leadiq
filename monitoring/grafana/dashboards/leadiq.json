{
  "uid": "leadiq",
  "title": "LeadIQ API",
  "schemaVersion": 39,
  "refresh": "10s",
  "time": {"from": "now-1h", "to": "now"},
  "panels": [
    {
      "id": 1, "type": "timeseries", "title": "Requests per second",
      "gridPos": {"x": 0, "y": 0, "w": 12, "h": 8},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"refId": "A", "expr": "sum(rate(leadiq_requests_total[1m])) by (path)", "legendFormat": "{{path}}"}]
    },
    {
      "id": 2, "type": "timeseries", "title": "p95 latency (seconds)",
      "gridPos": {"x": 12, "y": 0, "w": 12, "h": 8},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {"unit": "s"}},
      "targets": [{"refId": "A", "expr": "histogram_quantile(0.95, sum(rate(leadiq_request_latency_seconds_bucket[5m])) by (le, path))", "legendFormat": "{{path}}"}]
    },
    {
      "id": 3, "type": "stat", "title": "Error rate (5xx, last 5m)",
      "gridPos": {"x": 0, "y": 8, "w": 6, "h": 6},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {"unit": "percentunit", "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "red", "value": 0.05}]}}},
      "targets": [{"refId": "A", "expr": "sum(rate(leadiq_requests_total{status=~\"5..\"}[5m])) / sum(rate(leadiq_requests_total[5m])) or vector(0)"}]
    },
    {
      "id": 4, "type": "stat", "title": "Firing alerts",
      "gridPos": {"x": 6, "y": 8, "w": 6, "h": 6},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {"thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "red", "value": 1}]}}},
      "targets": [{"refId": "A", "expr": "count(ALERTS{alertstate=\"firing\"}) or vector(0)"}]
    },
    {
      "id": 5, "type": "piechart", "title": "Leads by band",
      "gridPos": {"x": 12, "y": 8, "w": 6, "h": 6},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"refId": "A", "expr": "sum(leadiq_predictions_total) by (band)", "legendFormat": "{{band}}"}]
    },
    {
      "id": 6, "type": "piechart", "title": "Traffic: champion vs canary",
      "gridPos": {"x": 18, "y": 8, "w": 6, "h": 6},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"refId": "A", "expr": "sum(leadiq_predictions_total) by (variant)", "legendFormat": "{{variant}}"}]
    },
    {
      "id": 7, "type": "timeseries", "title": "Rep feedback per minute",
      "gridPos": {"x": 0, "y": 14, "w": 24, "h": 7},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"refId": "A", "expr": "sum(rate(leadiq_feedback_total[5m])) by (converted) * 60", "legendFormat": "converted={{converted}}"}]
    }
  ]
}
